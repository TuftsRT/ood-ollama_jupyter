<%
  show_qos = false
  qos_options = (`sacctmgr show assoc where user=#{ENV['USER']} format=qos%1000 --noheader --parsable2 `).split(",")

  if qos_options.include?("interactive")
    show_qos = true
  end
%>
---

cluster: "pax"
bc_dynamic_js: true

attributes:
  conda_extensions: "0"
<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_tools.yml").indent(2) %>

  version:
    label: Version
    widget: select
    options:
            - ["0.11.4"]

  working_directory:
    widget: path_selector
    label: "Top Working Directory"
    directory: /cluster/home
    favorites:
         - /cluster/tufts
         - /cluster/home

  modeldir:
    label: Model directory
    widget: path_selector
    value: "/cluster/tufts/hpc/tools/ollama/models"
    directory: /cluster/tufts
    favorites:
      - /cluster/tufts
      - /cluster/home
    help: |
          A selection of commonly used models are available at `/cluster/tufts/hpc/tools/ollama/models` (managed by Research Technology).
          You may also provide your own model path if preferred.

  ta_qos:
    widget: check_box
    label: "Request priority start"
    help: "Limited to 1 running job at a time. (--qos=interactive)"
    value: "interactive"
    checked_value: "interactive"
    unchecked_value: "normal"

form:
  - conda_extensions
  - bc_num_hours
  - num_cores
  - num_memory
  - version
  - partition
<% if show_qos  %>
  - ta_qos
<%end%>
  - gpu_type
  - working_directory
  - modeldir
