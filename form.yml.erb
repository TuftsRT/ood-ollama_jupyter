---
<%
@partition_filter = :gpu
_partial_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/resource_discovery.erb'
ERB.new(File.read(_partial_path)).result(binding)
%>

cluster: "pax"
bc_dynamic_js: true

attributes:
  conda_extensions: "0"

<%= generate_partition_field.indent(2) %>
<%= generate_gpu_type_field.indent(2) %>
<%= generate_num_cores_field(
      extra_help: "As a rule of thumb, scale this with the size of the LLM you plan to run: " \
                  "larger models benefit from more cores for data loading and tokenization. " \
                  "If you are unsure, the default above is a reasonable starting point.",
      default_value: 8
    ).indent(2) %>
<%= generate_num_memory_field(
      extra_help: "A simple starting point is roughly double your selected core count, in GB " \
                  "(for example, 8 cores suggests about 16GB memory). Larger models need " \
                  "proportionally more.",
      default_value: 32
    ).indent(2) %>
<%= generate_num_hours_field.indent(2) %>

  version:
    label: Version
    widget: select
    options:
            - ["0.30.0"]
            - ["0.11.4"]

  working_directory:
    widget: path_selector
    label: "Top Working Directory"
    directory: /cluster/home
    favorites:
         - /cluster/tufts
         - /cluster/home

  modeldir:
    label: Model directory
    widget: path_selector
    value: "/cluster/tufts/hpc/tools/ollama/models"
    directory: /cluster/tufts
    favorites:
      - /cluster/tufts
      - /cluster/home
    help: |
          A selection of commonly used models are available at `/cluster/tufts/hpc/tools/ollama/models` (managed by Research Technology).
          You may also provide your own model path if preferred.

  ta_qos:
    widget: check_box
    label: "Request priority start"
    cacheable: false
    help: |
      Submits the job with `--qos=interactive` for higher scheduling priority, so it
      starts sooner. Intended for short, small sessions: while the box is checked, the
      resource fields above are automatically capped to the interactive QOS limits and
      a notice below lists them. Leave this box unchecked if your job needs more time
      or resources than those limits allow.
    value: "normal"
    checked_value: "interactive"
    unchecked_value: "normal"

  docs_link_block:
    widget: text_field
    class: "d-none"
    skip_label: true
    help: |
      For full documentation on this tool, see the [AI Tools guide](https://go.tufts.edu/AITools).

  disclaimer_block:
    widget: text_field
    class: "d-none"
    skip_label: true
<% if File.exist?("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_disclaimer.md")  %>
    help: |
<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_disclaimer.md").indent(11) %>
<%end%>

form:
  - docs_link_block
  - disclaimer_block
  - conda_extensions
  - partition
  - bc_num_hours
  - num_cores
  - num_memory
  - version
  - gpu_type
  - working_directory
  - modeldir
  - ta_qos
  - bc_email_on_started
