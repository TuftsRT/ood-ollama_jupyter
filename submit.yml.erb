---
batch_connect:
  template: "basic"
  conn_params:
    - working_path

script:
  email: <%= ENV["USER"] %>@tufts.edu
  job_name: "OnDemand/ollama-jupyter"
  before_script: "before.sh.erb"
  script: "script.sh.erb"

  native:
    - "--time=<%= bc_num_hours %>:00:00"
    - "--cpus-per-task=<%= num_cores %>"
    - "--mem=<%= num_memory %>G"
    - "--nodes=1"
    - "--partition=<%= partition %>"
<%
  # gpu_type values come from the ai_tools.yml partial
  skip_gres = !defined?(gpu_type) || gpu_type.to_s == "none"
%>
<% unless skip_gres %>
  <% if gpu_type == "a100" %>
    - "--gres=gpu:a100:1"
    - "--constraint=a100-40G"
  <% elsif gpu_type == "a100-80GB" %>
    - "--gres=gpu:a100:1"
    - "--constraint=a100-80G"
  <% elsif gpu_type == "rtx_6000ada" %>
    - "--gres=gpu:rtx_6000_ada:1"
  <% elsif gpu_type == "any" %>
    - "--gres=gpu:1"
  <% else %>
    - "--gres=gpu:<%= gpu_type %>:1"
  <% end %>
<% end %>
    <%- if defined?(ta_qos) && ta_qos == "interactive" -%>
    - "--qos=<%= ta_qos %>"
    <%- end -%>
